<?xml version="1.0" encoding="utf-8"?>
<!-- Respalda audios, base de datos y preferencias; NUNCA las credenciales (FR-002-05). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="secrets" />
        <exclude domain="file" path="updates" />
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="secrets" />
        <exclude domain="file" path="updates" />
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
