<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome alpha-mask glyph for QS tile / notification icon.
  System renders only the alpha channel, so this is stroke-only (no fills)
  to keep the open-ring + inner-arc shape visible after tinting.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,3 A9,9 0 1,1 4.8,17.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M8,12 A4,4 0 0,1 15,9.7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
